# Flask Application Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git!

# Flask Secret Key (generate with: python -c "import os; print(os.urandom(32).hex())")
SECRET_KEY=your-secret-key-here

# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET=your-s3-bucket-name
S3_QUARANTINE_BUCKET=your-quarantine-bucket-name
KMS_KEY_ID=your-kms-key-id

# Database Secret (AWS Secrets Manager secret ID)
DB_SECRET_ID=your-db-secret-id

# Flask Environment
FLASK_ENV=development
# FLASK_ENV=production  # Uncomment for production

# Optional: Flask Debug Mode (DO NOT use in production)
FLASK_DEBUG=True
